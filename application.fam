# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="f0_claude_remote",  # Must be unique
    name="Claude Remote",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="main_entry",
    stack_size=2 * 1024,
    fap_category="Examples",
    # Optional values
    # fap_version="0.1",
    fap_icon="f0_claude_remote.png",  # 10x10 1-bit PNG
    # fap_description="A simple app",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/f0_claude_remote",
    fap_icon_assets="images",  # Image assets to compile for this application
    fap_libs=["ble_profile"],  # ble_profile_hid is not among the firmware's exports
    sources=["*.c*", "!test"],
)
