root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
tab_width = 4
# Flipper's .clang-format: ColumnLimit 99.
max_line_length = 99

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# A trailing double space is a hard line break in Markdown: trimming it would
# change the rendered output.
trim_trailing_whitespace = false
